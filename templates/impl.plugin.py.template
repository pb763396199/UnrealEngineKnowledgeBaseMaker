def query_module_dependencies(module_name: str) -> Dict[str, Any]:
    """查询模块依赖关系"""
    all_modules = _get_global_modules()

    if module_name not in all_modules:
        return {{
            "error": f"未找到模块: {{module_name}}",
            "fallback_command": f"search_modules {{module_name}}",
            "hint": "模块名可能已变更或拼写不同，建议使用模糊搜索",
            "suggestions": list(all_modules.keys())[:10]
        }}

    info = all_modules[module_name]
    return {{
        "_meta": _get_kb_meta(),
        "module": module_name,
        "path": info['path'],
        "category": info['category'],
        "dependencies": info['dependencies'],
        "public_dependencies": info['public_dependencies'],
        "private_dependencies": info['private_dependencies']
    }}


def search_modules(keyword: str) -> Dict[str, Any]:
    """搜索包含关键字的模块"""
    all_modules = _get_global_modules()
    results = []

    keyword_lower = keyword.lower()
    for name, info in all_modules.items():
        if keyword_lower in name.lower():
            results.append({{
                "name": name,
                "category": info['category'],
                "path": info['path']
            }})

    return {{
        "_meta": _get_kb_meta(),
        "keyword": keyword,
        "found_count": len(results),
        "results": results[:50]
    }}


def get_statistics() -> Dict[str, Any]:
    """获取知识库统计信息"""
    all_modules = _get_global_modules()

    # 统计分类
    categories = {{}}
    for info in all_modules.values():
        cat = info['category'] or 'Unknown'
        categories[cat] = categories.get(cat, 0) + 1

    return {{
        "_meta": _get_kb_meta(),
        "total_modules": len(all_modules),
        "categories": categories
    }}


def get_kb_info() -> Dict[str, Any]:
    """获取知识库版本信息"""
    return {{
        "_meta": _get_kb_meta(),
        "plugin_name": KB_PLUGIN_NAME,
        "plugin_version": KB_PLUGIN_VERSION,
        "kb_format_version": KB_FORMAT_VERSION,
        "tool_version": KB_TOOL_VERSION,
        "created_at": KB_CREATED_AT,
        "last_updated": KB_LAST_UPDATED,
        "kb_path": str(KB_PATH)
    }}


def ensure_fresh(source: str = None, force: bool = False) -> Dict[str, Any]:
    """Ensure the active KB matches the current plugin source before querying."""
    active_record = _get_active_branch_record()
    if not active_record:
        return {{"fresh": False, "updated": False, "error": "No active KB branch"}}

    cwd_source = _find_plugin_root_from_cwd()
    selected_source = Path(source) if source else (cwd_source or Path(active_record.get("source", "")))
    if not str(selected_source):
        return {{"fresh": False, "updated": False, "error": "No source path available"}}

    source_record = _find_branch_record_for_source(selected_source)
    branch_name = (
        source_record.get("branch")
        if source_record
        else _derive_branch_name_from_source(selected_source)
    )

    active_branch = active_record.get("branch")
    active_switched = False
    if source_record and branch_name and branch_name != active_branch:
        switch_result = _branch_mgr.set_active(branch_name)
        active_switched = "error" not in switch_result
        if active_switched:
            _refresh_runtime_paths()

    registry_source = source_record.get("source") if source_record else None
    source_mismatch = source_record is None
    if registry_source:
        source_mismatch = _normalize_path_for_compare(Path(registry_source)) != _normalize_path_for_compare(selected_source)

    freshness = _branch_mgr.check_freshness(str(selected_source))
    needs_update = force or source_mismatch or not freshness.get("fresh", False)
    if not needs_update:
        _refresh_runtime_paths()
        return {{
            "fresh": True,
            "updated": False,
            "branch": branch_name,
            "source": str(selected_source),
            "active_switched": active_switched,
            "freshness": freshness,
        }}

    update_result = _branch_mgr.update(
        branch_name,
        str(selected_source),
        force=force or source_mismatch,
        description="auto ensure_fresh before query",
    )

    if "error" not in update_result:
        _refresh_runtime_paths()

    return {{
        "fresh": "error" not in update_result,
        "updated": "error" not in update_result,
        "branch": branch_name,
        "source": str(selected_source),
        "active_switched": active_switched,
        "source_mismatch": source_mismatch,
        "freshness_before": freshness,
        "update": update_result,
    }}



# Skill 目录（impl.py 所在目录）
SKILL_DIR = Path(__file__).parent

# 知识库路径 — 无 registry 时兼容硬编码路径；registry 异常时 fail-closed
_DEFAULT_KB_PATH = Path(r"{KB_PATH}")
_branch_mgr = BranchManager(SKILL_DIR)
_KB_RESOLUTION_ERROR = None
_UNRESOLVED_KB_PATH = SKILL_DIR / "runtime" / "unresolved_kb"


def _resolve_kb_path(variant: str = None) -> Path:
    """解析活跃 KB 路径；registry 存在但异常时不回退旧 KB"""
    global _KB_RESOLUTION_ERROR
    try:
        _KB_RESOLUTION_ERROR = None
        return _branch_mgr.resolve_kb_path(variant)
    except FileNotFoundError as e:
        if not _branch_mgr.registry_db.exists():
            _KB_RESOLUTION_ERROR = None
            return _DEFAULT_KB_PATH
        _KB_RESOLUTION_ERROR = f"resolve_kb_path failed: {type(e).__name__}: {e}"
        print(f"[KB] ERROR: {_KB_RESOLUTION_ERROR}", file=sys.stderr)
        return _UNRESOLVED_KB_PATH
    except Exception as e:
        _KB_RESOLUTION_ERROR = f"resolve_kb_path failed: {type(e).__name__}: {e}"
        print(f"[KB] ERROR: {_KB_RESOLUTION_ERROR}", file=sys.stderr)
        return _UNRESOLVED_KB_PATH


def _registry_resolution_error() -> Optional[str]:
    return _KB_RESOLUTION_ERROR


KB_PATH = _resolve_kb_path()


def _resolve_source_root(variant: str = None) -> Optional[Path]:
    """解析源码根目录（来自 registry versions.source_path），失败时返回 None"""
    try:
        return _branch_mgr.resolve_source_path(variant)
    except Exception as e:
        print(f"[KB] WARNING: resolve_source_path failed ({type(e).__name__}: {e})", file=sys.stderr)
        return None


SOURCE_ROOT = _resolve_source_root()


def _resolve_source_file(path_value: str) -> Path:
    """将 impl_file_path（可能是相对路径）解析为绝对路径"""
    p = Path(path_value)
    if p.is_absolute():
        return p
    if SOURCE_ROOT is not None:
        parts = path_value.replace("\\", "/").split("/")
        return SOURCE_ROOT.joinpath(*parts)
    return p


def _get_runtime_context() -> Dict[str, Any]:
    """收集当前 KB 的运行时上下文和索引状态"""
    current_source = _find_plugin_root_from_cwd() or SOURCE_ROOT
    context = _build_preflight(
        skill_dir=SKILL_DIR,
        kb_path=KB_PATH,
        source_root=current_source,
        branch_manager=_branch_mgr,
    )
    if _registry_resolution_error():
        context["data_trust"] = "stale"
        context["fresh"] = False
        context["stale_reason"] = "kb_resolution_failed"
        context["registry_error"] = _registry_resolution_error()
    return context


def preflight() -> Dict[str, Any]:
    """查询前检查 KB/source/indices 新鲜度"""
    return _get_runtime_context()


def query_audit(trace_id: str = None, limit: int = 20) -> Dict[str, Any]:
    """查看最近查询审计记录（SKILL_DIR/runtime/query_audit.db）"""
    audit = QueryAudit.for_skill(SKILL_DIR)
    try:
        return audit.recent(trace_id, limit)
    finally:
        audit.close()


def source_slice(
    relative_file: str,
    line_number: int,
    mode: str = "context",
    context_lines: int = 8,
    max_context_lines: int = 200,
    max_output_chars: int = 20000,
) -> Dict[str, Any]:
    """安全读取 source_root 内的源码切片"""
    if SOURCE_ROOT is None:
        return {{"error": "source_root is not available"}}
    try:
        result = _slice_source(
            source_root=SOURCE_ROOT,
            relative_file=relative_file,
            line_number=int(line_number),
            mode=mode,
            context_lines=int(context_lines),
            max_context_lines=int(max_context_lines),
            max_output_chars=int(max_output_chars),
        )
        result["_meta"] = _get_kb_meta()
        return result
    except Exception as e:
        return {{"error": str(e), "file": relative_file, "line": line_number, "mode": mode}}


def search_files(keyword: str, limit: int = 20) -> Dict[str, Any]:
    """搜索源码文件全文索引，FTS5 不可用时降级 LIKE"""
    result = _search_files_index(KB_PATH / "global_index" / "files_fts.db", keyword, limit)
    result["_meta"] = _get_kb_meta()
    return result


def _record_query_audit(
    command: str,
    args: List[str],
    result: Dict[str, Any] = None,
    error: str = None,
    trace_id: str = None,
    started_at: float = None,
) -> str:
    try:
        context = _get_runtime_context()
    except Exception:
        context = _get_kb_meta()
    try:
        return record_query(
            skill_dir=SKILL_DIR,
            trace_id=trace_id,
            command=command,
            args=args,
            context=context,
            result=result,
            error=error,
            started_at=started_at,
            finished_at=time.time(),
        )
    except Exception:
        return resolve_trace_id(trace_id)

# KB 版本信息（插件模式）
KB_PLUGIN_NAME = "{PLUGIN_NAME}"
KB_PLUGIN_VERSION = "{PLUGIN_VERSION}"
KB_FORMAT_VERSION = "{KB_VERSION}"
KB_TOOL_VERSION = "{TOOL_VERSION}"
KB_CREATED_AT = "{CREATED_AT}"
KB_LAST_UPDATED = "{LAST_UPDATED}"

# 全局缓存
_global_index_cache = None
_module_graphs_cache = {{}}
_db_connection = None
_class_index_cache = None
_function_index_cache = None
_symbol_reference_index_cache = None
_enum_index_cache = None
_kb_meta_cache = None


def _path_under_root(path_value: str, root: Optional[Path]) -> str:
    """Convert an indexed path to a source-root-relative POSIX path when possible."""
    if root is None or not path_value:
        return path_value
    path = Path(path_value)
    if not path.is_absolute():
        return path_value
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except Exception:
        return path_value


def _refresh_runtime_paths() -> None:
    """Refresh active KB/source paths and query caches after same-process branch updates."""
    global KB_PATH, SOURCE_ROOT, _db_connection, _global_index_cache
    global _class_index_cache, _function_index_cache, _symbol_reference_index_cache, _enum_index_cache, _kb_meta_cache
    KB_PATH = _resolve_kb_path()
    SOURCE_ROOT = _resolve_source_root()
    if _db_connection is not None:
        try:
            _db_connection.close()
        except Exception:
            pass
    _db_connection = None
    _global_index_cache = None
    _class_index_cache = None
    _function_index_cache = None
    _symbol_reference_index_cache = None
    _enum_index_cache = None
    _kb_meta_cache = None


def _normalize_path_for_compare(path: Path) -> str:
    """Return a normalized path string for cross-drive/source comparisons."""
    try:
        return str(path.resolve()).lower()
    except Exception:
        return str(path).lower()


def _find_plugin_root_from_cwd() -> Optional[Path]:
    """Find a .uplugin-owning plugin root from the current working directory."""
    cwd = Path.cwd()
    for candidate in [cwd] + list(cwd.parents):
        try:
            if any(candidate.glob("*.uplugin")):
                return candidate
        except OSError:
            continue
    return None


def _get_active_branch_record() -> Optional[Dict[str, Any]]:
    """Return the active branch record from BranchManager.status()."""
    try:
        status = _branch_mgr.status()
    except Exception:
        return None
    active = status.get("active_branch")
    for branch in status.get("branches", []):
        if branch.get("active") or branch.get("branch") == active:
            return branch
    return None


def _find_branch_record_for_source(source: Path) -> Optional[Dict[str, Any]]:
    """Return the registered branch whose source path matches source."""
    try:
        status = _branch_mgr.status()
    except Exception:
        return None

    normalized_source = _normalize_path_for_compare(source)
    default_match = None
    for branch in status.get("branches", []):
        branch_source = branch.get("source")
        if not branch_source:
            continue
        if _normalize_path_for_compare(Path(branch_source)) == normalized_source:
            if branch.get("branch") != "default":
                return branch
            default_match = branch
    return default_match


def _derive_branch_name_from_source(source: Path) -> str:
    """Derive a stable registry branch name from a plugin source path."""
    try:
        if source.parent.name.lower() == "plugins" and source.parent.parent.name:
            return source.parent.parent.name
    except Exception:
        pass
    return source.name or "default"


def _get_kb_meta() -> Dict[str, Any]:
    """获取当前 KB 的分支/commit/新鲜度元数据（缓存）"""
    global _kb_meta_cache
    if _kb_meta_cache is not None:
        return _kb_meta_cache

    meta = {{"branch": None, "commit": None, "built_at": None, "data_trust": "unknown"}}
    if _registry_resolution_error():
        meta["data_trust"] = "stale"
        meta["stale_reason"] = "kb_resolution_failed"
        meta["registry_error"] = _registry_resolution_error()
        _kb_meta_cache = meta
        return meta
    try:
        active_record = _get_active_branch_record()
        if active_record:
            meta["branch"] = active_record.get("branch")
            meta["commit"] = active_record.get("commit")
            meta["built_at"] = active_record.get("built_at")
            meta["source"] = active_record.get("source")
            meta["data_trust"] = "unknown"

            cwd_source = _find_plugin_root_from_cwd()
            selected_source = cwd_source or (Path(active_record.get("source")) if active_record.get("source") else None)
            if cwd_source:
                meta["current_source"] = str(cwd_source)
                registry_source = active_record.get("source")
                if registry_source and _normalize_path_for_compare(Path(registry_source)) != _normalize_path_for_compare(cwd_source):
                    meta["data_trust"] = "stale"
                    meta["stale_reason"] = "current_source_mismatch"
            if selected_source and "stale_reason" not in meta:
                freshness = _branch_mgr.check_freshness(str(selected_source))
                meta["data_trust"] = "fresh" if freshness.get("fresh") else "stale"
                meta["freshness"] = freshness
    except Exception:
        pass

    _kb_meta_cache = meta
    return meta



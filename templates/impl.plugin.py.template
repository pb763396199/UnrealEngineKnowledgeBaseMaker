def source_slice(
    relative_file: str,
    line_number: int,
    mode: str = "context",
    context_lines: int = 8,
    max_context_lines: int = 200,
    max_output_chars: int = 20000,
) -> Dict[str, Any]:
    """安全读取 source_root 内的源码切片"""
    if SOURCE_ROOT is None:
        return {{"error": "source_root is not available"}}
    try:
        result = _slice_source(
            source_root=SOURCE_ROOT,
            relative_file=relative_file,
            line_number=int(line_number),
            mode=mode,
            context_lines=int(context_lines),
            max_context_lines=int(max_context_lines),
            max_output_chars=int(max_output_chars),
        )
        result["_meta"] = _get_kb_meta()
        return result
    except Exception as e:
        return {{"error": str(e), "file": relative_file, "line": line_number, "mode": mode}}


def search_files(keyword: str, limit: int = 20) -> Dict[str, Any]:
    """搜索源码文件全文索引，FTS5 不可用时降级 LIKE"""
    result = _search_files_index(KB_PATH / "global_index" / "files_fts.db", keyword, limit)
    result["_meta"] = _get_kb_meta()
    return result


def _record_query_audit(
    command: str,
    args: List[str],
    result: Dict[str, Any] = None,
    error: str = None,
    trace_id: str = None,
    started_at: float = None,
) -> str:
    try:
        context = _get_runtime_context()
    except Exception:
        context = _get_kb_meta()
    try:
        return record_query(
            skill_dir=SKILL_DIR,
            trace_id=trace_id,
            command=command,
            args=args,
            context=context,
            result=result,
            error=error,
            started_at=started_at,
            finished_at=time.time(),
        )
    except Exception:
        return resolve_trace_id(trace_id)


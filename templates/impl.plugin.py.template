    def _env_flag(name):
        return os.environ.get(name, "").lower() in ("1", "true", "yes", "on")

    def _extract_runtime_args(raw_argv):
        trace_id = None
        allow_stale = False
        no_audit = False
        read_only = False
        cleaned = []
        args = list(raw_argv[1:])
        i = 0
        while i < len(args):
            arg = args[i]
            if arg == "--trace-id":
                if i + 1 >= len(args):
                    print("Error: --trace-id requires a value", file=sys.stderr)
                    sys.exit(1)
                trace_id = args[i + 1]
                i += 2
                continue
            if arg.startswith("--trace-id="):
                trace_id = arg.split("=", 1)[1]
                i += 1
                continue
            if arg == "--allow-stale":
                allow_stale = True
                i += 1
                continue
            if arg == "--no-audit":
                no_audit = True
                i += 1
                continue
            if arg == "--read-only":
                read_only = True
                i += 1
                continue
            cleaned.append(arg)
            i += 1
        return trace_id, allow_stale, no_audit, read_only, cleaned

    def _command_requires_fresh(command):
        return command not in {
            "preflight", "query_audit", "status", "check_freshness", "get_kb_info",
            "ensure_fresh", "init", "register", "update", "set_active", "remove", "gc",
        }

    def _write_command(command):
        return command in {"ensure_fresh", "init", "register", "update", "set_active", "remove", "gc"}

    def _stale_gate_result(command):
        context = _get_runtime_context()
        if context.get("data_trust") == "stale":
            return {
                "error": "KB data_trust is stale; run preflight/ensure_fresh or pass --allow-stale",
                "command": command,
                "data_trust": "stale",
                "preflight": context,
            }
        return None


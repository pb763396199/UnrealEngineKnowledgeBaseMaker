            arg = args[i]
            if arg == "--trace-id":
                if i + 1 >= len(args):
                    print("Error: --trace-id requires a value", file=sys.stderr)
                    sys.exit(1)
                trace_id = args[i + 1]
                i += 2
                continue
            if arg.startswith("--trace-id="):
                trace_id = arg.split("=", 1)[1]
                i += 1
                continue
            if arg == "--allow-stale":
                allow_stale = True
                i += 1
                continue
            if arg == "--no-audit":
                no_audit = True
                i += 1
                continue
            if arg == "--read-only":
                read_only = True
                i += 1
                continue
            cleaned.append(arg)
            i += 1
        return trace_id, allow_stale, no_audit, read_only, cleaned

    def _command_requires_fresh(command):
        return command not in {
            "preflight", "query_audit", "query_audit_report", "status", "check_freshness", "get_kb_info",
            "ensure_fresh", "init", "register", "update", "set_active", "remove", "gc",
            "query_memory_search", "query_memory_record", "query_memory_promote",
            "query_memory_subjects", "query_memory_negative_hints",
            "query_memory_snapshot", "query_memory_render", "query_memory_render_graph", "query_memory_attach_flow",
        }

    def _write_command(command):
        return command in {
            "ensure_fresh", "init", "register", "update", "set_active", "remove", "gc",
            "query_memory_record", "query_memory_validate", "query_memory_diff", "query_memory_promote",
            "query_memory_snapshot", "query_memory_render", "query_memory_render_graph", "query_memory_attach_flow",
        }

    def _stale_gate_result(command):
        context = _get_runtime_context()
        if context.get("data_trust") == "stale":
            return {
                "error": "KB data_trust is stale; run preflight/ensure_fresh or pass --allow-stale",
                "command": command,
                "data_trust": "stale",
                "preflight": context,
            }
        return None


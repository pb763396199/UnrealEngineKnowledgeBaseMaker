    def _require(args, count, message):
        if len(args) < count:
            print(f"Error: {message}", file=sys.stderr)
            _print_usage()

    def _option_value(args, option):
        if option not in args:
            return None
        idx = args.index(option)
        return args[idx + 1] if idx + 1 < len(args) else None

    def _run_command(command, args, allow_stale=False, read_only=False):
        if read_only and _write_command(command):
            return {
                "error": f"Command '{command}' is disabled in read-only mode",
                "command": command,
                "read_only": True,
            }
        if not allow_stale and _command_requires_fresh(command):
            blocked = _stale_gate_result(command)
            if blocked:
                return blocked
        if command == "preflight":
            return preflight()
        if command == "query_class_info":
            _require(args, 1, "Missing class_name argument")
            return query_class_info(args[0])
        if command == "query_class_hierarchy":
            _require(args, 1, "Missing class_name argument")
            depth = int(args[1]) if len(args) > 1 else 3
            return query_class_hierarchy(args[0], depth)
        if command == "query_module_dependencies":
            _require(args, 1, "Missing module_name argument")
            return query_module_dependencies(args[0])
        if command == "query_module_classes":
            _require(args, 1, "Missing module_name argument")
            class_type = args[1] if len(args) > 1 else None
            return query_module_classes(args[0], class_type)
        if command == "query_function_info":
            _require(args, 1, "Missing function_name argument")
            module_hint = args[1] if len(args) > 1 else None
            return query_function_info(args[0], module_hint)
        if command == "get_function_implementation":
            _require(args, 1, "Missing function_name argument")
            class_name = args[1] if len(args) > 1 else None
            module_hint = args[2] if len(args) > 2 else None
            signature_hint = args[3] if len(args) > 3 else None
            return get_function_implementation(args[0], class_name, module_hint, signature_hint)
        if command == "source_slice":
            return source_slice(*_parse_source_slice_cli_args(args))
        if command == "search_files":
            _require(args, 1, "Missing keyword argument")
            limit = int(args[1]) if len(args) > 1 else 20
            return search_files(args[0], limit)
        if command == "resolve_seed":
            _require(args, 1, "Missing seed argument")
            limit = int(args[1]) if len(args) > 1 else 20
            return resolve_seed(args[0], limit)
        if command == "search_functions":
            _require(args, 1, "Missing keyword argument")
            limit = int(args[1]) if len(args) > 1 else 50
            return search_functions(args[0], limit)
        if command == "search_classes":
            _require(args, 1, "Missing keyword argument")
            limit = int(args[1]) if len(args) > 1 else 50
            return search_classes(args[0], limit)
        if command == "search_enums":
            _require(args, 1, "Missing keyword argument")
            limit = int(args[1]) if len(args) > 1 else 50
            return search_enums(args[0], limit)
        if command == "search_modules":
            _require(args, 1, "Missing keyword argument")
            return search_modules(args[0])
        if command == "get_statistics":
            return get_statistics()
        if command == "get_kb_info":
            return get_kb_info()
        if command == "ensure_fresh":
            force = "--force" in args
            source = None
            for arg in args:
                if arg != "--force":
                    source = arg
                    break
            return ensure_fresh(source, force)
        if command == "query_callees":
            _require(args, 1, "Missing function_name argument")
            class_name, limit, confidence = _parse_optional_class_limit_confidence(args[1:])
            return query_callees(args[0], class_name, limit, confidence)
        if command == "query_callers":
            _require(args, 1, "Missing function_name argument")
            class_name, limit, confidence = _parse_optional_class_limit_confidence(args[1:])
            return query_callers(args[0], class_name, limit, confidence)
        if command == "query_symbol_references":
            _require(args, 1, "Missing symbol_name argument")
            limit, confidence = _parse_optional_limit_confidence(args[1:])
            return query_symbol_references(args[0], limit, confidence)
        if command == "symbol_reference_report":
            _require(args, 1, "Missing symbol_name argument")
            limit, resolution_state = _parse_optional_limit_confidence(args[1:])
            return symbol_reference_report(args[0], limit, resolution_state)
        if command == "symbol_evidence_bundle":
            _require(args, 1, "Missing symbol_name argument")
            limit, resolution_state = _parse_optional_limit_confidence(args[1:])
            return symbol_evidence_bundle(args[0], limit, resolution_state)
        if command == "code_flow_index":
            limit = int(args[0]) if args and args[0].isdigit() else 100
            resolution_state = args[1] if len(args) > 1 else (args[0] if args and not args[0].isdigit() else "all")
            return code_flow_index(limit, resolution_state)
        if command == "query_static_closure":
            _require(args, 1, "Missing seed argument")
            depth = int(args[1]) if len(args) > 1 else 3
            limit = int(args[2]) if len(args) > 2 else 80
            resolution_state = args[3] if len(args) > 3 else "all"
            return query_static_closure(args[0], depth, limit, resolution_state)
        if command == "query_flow":
            _require(args, 1, "Missing seed argument")
            direction = args[1] if len(args) > 1 else "both"
            edge_types = args[2] if len(args) > 2 else "call,type_reference"
            depth = int(args[3]) if len(args) > 3 else 1
            limit = int(args[4]) if len(args) > 4 else 50
            resolution_state = args[5] if len(args) > 5 else "all"
            return query_flow(args[0], direction, edge_types, depth, limit, resolution_state)
        if command == "trace_business_flow":
            _require(args, 1, "Missing seed argument")
            depth = int(args[1]) if len(args) > 1 else 4
            limit = int(args[2]) if len(args) > 2 else 160
            resolution_state = args[3] if len(args) > 3 else "resolved"
            evidence_limit = int(args[4]) if len(args) > 4 else 12
            return trace_business_flow(args[0], depth, limit, resolution_state, evidence_limit)
        if command == "trace_flow_path":
            _require(args, 2, "Missing trace_flow_path arguments")
            depth = int(args[2]) if len(args) > 2 else 4
            limit = int(args[3]) if len(args) > 3 else 200
            resolution_state = args[4] if len(args) > 4 else "resolved"
            return trace_flow_path(args[0], args[1], depth, limit, resolution_state)
        if command == "query_audit":
            trace = None
            limit = 20
            if "--limit" in args:
                idx = args.index("--limit")
                if idx + 1 >= len(args):
                    return {"error": "query_audit --limit requires a value"}
                limit = int(args[idx + 1])
                args = args[:idx] + args[idx + 2:]
            if args:
                if len(args) == 1 and args[0].isdigit():
                    limit = int(args[0])
                else:
                    trace = args[0]
                    if len(args) > 1:
                        limit = int(args[1])
            return query_audit(trace, limit)
        if command == "query_audit_report":
            trace = None
            limit = 200
            broad_threshold = 40
            if args:
                if len(args) == 1 and args[0].isdigit():
                    limit = int(args[0])
                else:
                    trace = args[0]
                    if len(args) > 1:
                        limit = int(args[1])
                    if len(args) > 2:
                        broad_threshold = int(args[2])
            return query_audit_report(trace, limit, broad_threshold)
        if command == "query_memory_record":
            _require(args, 3, "Missing query_memory_record arguments")
            return query_memory_record(args[0], args[1], args[2])
        if command == "query_memory_search":
            _require(args, 1, "Missing keyword argument")
            intent = args[1] if len(args) > 1 else None
            limit = int(args[2]) if len(args) > 2 else 20
            return query_memory_search(args[0], intent, limit)
        if command == "query_memory_validate":
            _require(args, 1, "Missing memory_id argument")
            return query_memory_validate(args[0])
        if command == "query_memory_replay":
            _require(args, 1, "Missing memory_id argument")
            return query_memory_replay(args[0])
        if command == "query_memory_diff":
            _require(args, 1, "Missing memory_id argument")
            return query_memory_diff(args[0])
        if command == "query_memory_promote":
            _require(args, 3, "Missing query_memory_promote arguments")
            return query_memory_promote(args[0], args[1], args[2])
        if command == "query_memory_subjects":
            keyword = args[0] if args else None
            limit = int(args[1]) if len(args) > 1 else 50
            return query_memory_subjects(keyword, limit)
        if command == "query_memory_negative_hints":
            keyword = args[0] if args else None
            limit = int(args[1]) if len(args) > 1 else 50
            return query_memory_negative_hints(keyword, limit)
        if command == "query_memory_snapshot":
            _require(args, 1, "Missing query_memory_snapshot subject_id")
            return query_memory_snapshot(args[0])
        if command == "query_memory_render":
            target = args[0] if args else "all"
            view = args[1] if len(args) > 1 else "full"
            return query_memory_render(target, view)
        if command == "query_memory_render_graph":
            target = args[0] if args else "all"
            view = args[1] if len(args) > 1 else "business"
            return query_memory_render_graph(target, view)
        if command == "query_memory_attach_flow":
            _require(args, 2, "Missing query_memory_attach_flow arguments")
            return query_memory_attach_flow(args[0], args[1])
        if command == "init":
            return _branch_mgr.init_registry(_option_value(args, "--kb_store"))
        if command == "register":
            _require(args, 2, "register <branch> <source> [--kb <path>]")
            return _branch_mgr.register(args[0], args[1], _option_value(args, "--kb"), _option_value(args, "--desc") or "")
        if command == "update":
            _require(args, 2, "update <branch> <source> [--force]")
            return _branch_mgr.update(args[0], args[1], "--force" in args, _option_value(args, "--desc") or "")
        if command == "status":
            return _branch_mgr.status()
        if command == "set_active":
            _require(args, 1, "set_active <branch>")
            return _branch_mgr.set_active(args[0])
        if command == "check_freshness":
            _require(args, 1, "check_freshness <source>")
            return _branch_mgr.check_freshness(args[0])
        if command == "remove":
            _require(args, 1, "remove <branch> [--delete-data]")
            return _branch_mgr.remove(args[0], "--delete-data" in args)
        if command == "gc":
            return _branch_mgr.gc("--dry-run" in args)
        print(f"Error: Unknown command '{command}'", file=sys.stderr)
        _print_usage()

    trace_id, allow_stale, no_audit, read_only, cli_args = _extract_runtime_args(sys.argv)
    allow_stale = allow_stale or _env_flag("UE5KB_ALLOW_STALE")
    no_audit = no_audit or _env_flag("UE5KB_NO_AUDIT")
    read_only = read_only or _env_flag("UE5KB_READ_ONLY")
    if len(cli_args) < 1:
        _print_usage()
    if cli_args[0] in ("-h", "--help", "help"):
        _print_usage(0)

    command = cli_args[0]
    command_args = cli_args[1:]
    started_at = time.time()

    try:
        result = _run_command(command, command_args, allow_stale=allow_stale, read_only=read_only)
        if command not in {
            "query_audit", "query_audit_report",
            "query_memory_search", "query_memory_validate", "query_memory_replay",
            "query_memory_diff", "query_memory_record", "query_memory_promote",
            "query_memory_subjects", "query_memory_negative_hints",
            "query_memory_snapshot", "query_memory_render", "query_memory_render_graph", "query_memory_attach_flow",
        } and not no_audit:
            audit_error = result.get("error") if isinstance(result, dict) else None
            resolved_trace_id = _record_query_audit(
                command,
                command_args,
                result=result,
                error=audit_error,
                trace_id=trace_id,
                started_at=started_at,
            )
            if isinstance(result, dict):
                result.setdefault("_audit", {{}})["trace_id"] = resolved_trace_id
        print(json.dumps(result, ensure_ascii=True, indent=2))

    except Exception as e:
        resolved_trace_id = resolve_trace_id(trace_id)
        if not no_audit:
            try:
                _record_query_audit(
                    command,
                    command_args,
                    error=str(e),
                    trace_id=resolved_trace_id,
                    started_at=started_at,
                )
            except Exception:
                pass
        error_result = {{"error": str(e), "command": command, "args": command_args, "_audit": {{"trace_id": resolved_trace_id}}}}
        print(json.dumps(error_result, ensure_ascii=True, indent=2))
        sys.exit(1)

def query_class_info(class_name: str) -> Dict[str, Any]:
    """查询类的详细信息"""
    # 查找类所在的模块
    module_name = _find_module_for_class(class_name)
    if not module_name:
        return {{
            "error": f"未找到类: {{class_name}}",
            "fallback_command": f"search_classes {{class_name}}",
            "hint": "类名可能已变更或拼写不同，建议使用模糊搜索"
        }}

    # 加载模块图谱
    graph = _load_module_graph(module_name)
    if not graph:
        return {{"error": f"无法加载模块图谱: {{module_name}}"}}

    # 查找类节点
    class_node = f"class_{{class_name}}"
    if class_node not in graph.nodes:
        return {{"error": f"类 {{class_name}} 不在模块 {{module_name}} 的图谱中"}}

    # 提取类信息
    node_data = graph.nodes[class_node]

    return {{
        "_meta": _get_kb_meta(),
        "class_name": class_name,
        "module": module_name,
        "file": node_data.get('file', ''),
        "line": node_data.get('line', 0),
        "parent_classes": node_data.get('parent_classes', []),
        "is_uclass": node_data.get('is_uclass', False),
        "is_struct": node_data.get('is_struct', False),
        "is_interface": node_data.get('is_interface', False),
        "is_blueprintable": node_data.get('is_blueprintable', False),
        "specifiers": node_data.get('specifiers', {{}})
    }}


def query_class_hierarchy(class_name: str, depth: int = 3) -> Dict[str, Any]:
    """查询类的继承层次结构"""
    result = []
    current_class = class_name

    for i in range(depth):
        info = query_class_info(current_class)
        if 'error' in info:
            break

        result.append({{
            "level": i,
            "class": current_class,
            "module": info.get("module"),
            "file": info.get("file")
        }})

        parents = info.get("parent_classes", [])
        if not parents:
            break

        current_class = parents[0]

    return {{
        "_meta": _get_kb_meta(),
        "class": class_name,
        "hierarchy": result,
        "depth": len(result)
    }}


def query_module_classes(module_name: str, class_type: str = None) -> Dict[str, Any]:
    """查询模块中的所有类"""
    graph = _load_module_graph(module_name)
    if not graph:
        return {{"error": f"无法加载模块图谱: {{module_name}}"}}

    classes = []
    for node, node_data in graph.nodes(data=True):
        if node_data.get('type') != 'class':
            continue

        if class_type == 'uclass' and not node_data.get('is_uclass'):
            continue
        elif class_type == 'struct' and not node_data.get('is_struct'):
            continue
        elif class_type == 'interface' and not node_data.get('is_interface'):
            continue

        class_name = node_data.get('name', node.replace('class_', ''))
        classes.append({{
            "name": class_name,
            "is_uclass": node_data.get('is_uclass', False),
            "is_struct": node_data.get('is_struct', False),
            "file": node_data.get('file', '')
        }})

    return {{
        "_meta": _get_kb_meta(),
        "module": module_name,
        "total_classes": len(classes),
        "classes": classes[:100]
    }}


def _split_qualified_function_name(function_name: str) -> tuple:
    """Parse Class::Function with deterministic string rules."""
    raw = (function_name or "").strip()
    if "::" not in raw:
        return None, raw
    qualifier, short_name = raw.rsplit("::", 1)
    qualifier = qualifier.strip() or None
    short_name = short_name.strip() or raw
    return qualifier, short_name


def _normalize_function_result(row: Dict[str, Any], requested_name: str, short_name: str) -> Dict[str, Any]:
    return {{
        "function": short_name,
        "requested_function": requested_name,
        "module": row.get('module', ''),
        "return_type": row.get('return_type', ''),
        "parameters": row.get('parameters', []),
        "is_ufunction": bool(row.get('is_ufunction', False)),
        "is_blueprint_callable": bool(row.get('is_blueprint_callable', False)),
        "ufunction_specifiers": row.get('ufunction_specifiers', {{}}),
        "file": row.get('file_path', '') or row.get('file', ''),
        "line": row.get('line_number', 0) or row.get('line', 0),
        "impl_file": row.get('impl_file_path', '') or row.get('impl_file', ''),
        "impl_line": row.get('impl_line_number', 0) or row.get('impl_line', 0),
        "class": row.get('class_name', '') or row.get('class', ''),
        "signature": row.get('signature', ''),
    }}


def _function_resolution_state(results: List[Dict[str, Any]], qualifier: str = None) -> str:
    if not results:
        return "unresolved"
    if qualifier and any((r.get("class") or "") != qualifier for r in results):
        return "ambiguous"
    return "resolved" if len(results) == 1 else "ambiguous"


def _dedupe_function_results(results: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    deduped = []
    seen = set()
    for row in results:
        if row.get("impl_file"):
            key = (
                row.get("module", ""),
                row.get("class", ""),
                row.get("function", ""),
                row.get("impl_file", ""),
                row.get("impl_line", 0),
            )
        else:
            key = (
                row.get("module", ""),
                row.get("class", ""),
                row.get("function", ""),
                row.get("file", ""),
                row.get("line", 0),
            )
        if key in seen:
            continue
        seen.add(key)
        deduped.append(row)
    return deduped


def query_function_info(function_name: str, module_hint: str = None) -> Dict[str, Any]:
    """查询函数信息（静态解析，支持 Class::Function 限定名）"""
    qualifier, short_name = _split_qualified_function_name(function_name)
    func_idx = _get_function_index()

    if func_idx:
        # 使用 SQLite 索引查询（< 10ms）
        raw = func_idx.query_by_name(short_name, module_hint)
        if qualifier:
            raw = [r for r in raw if (r.get('class_name') or '') == qualifier]
        if raw:
            results = [_normalize_function_result(r, function_name, short_name) for r in raw]
            results = _dedupe_function_results(results)
            return {{
                "_meta": _get_kb_meta(),
                "function_name": short_name,
                "requested_function_name": function_name,
                "qualifier": qualifier,
                "resolution_state": _function_resolution_state(results, qualifier),
                "candidate_count": len(results),
                "found_count": len(results),
                "results": results[:20]
            }}

    # SQLite 索引不可用或未找到，回退到 pkl 遍历
    results = []
    if module_hint:
        modules = [module_hint]
    else:
        all_modules = _get_global_modules()
        modules = list(all_modules.keys())[:50]

    for mod in modules:
        graph = _load_module_graph(mod)
        if not graph:
            continue

        for node, node_data in graph.nodes(data=True):
            if node_data.get('type') != 'function':
                continue
            if node_data.get('name') == short_name:
                row = _normalize_function_result(node_data, function_name, short_name)
                row["module"] = mod
                if qualifier and row.get("class") != qualifier:
                    continue
                results.append(row)

    if not results:
        keyword = function_name[:8] if len(function_name) > 8 else function_name
        return {{
            "error": f"未找到函数: {{function_name}}",
            "function_name": short_name,
            "requested_function_name": function_name,
            "qualifier": qualifier,
            "resolution_state": "unresolved",
            "candidate_count": 0,
            "fallback_command": f"search_functions {{keyword}}",
            "hint": "函数名可能已变更或拼写不同，建议使用模糊搜索"
        }}

    results = _dedupe_function_results(results)
    return {{
        "_meta": _get_kb_meta(),
        "function_name": short_name,
        "requested_function_name": function_name,
        "qualifier": qualifier,
        "resolution_state": _function_resolution_state(results, qualifier),
        "candidate_count": len(results),
        "found_count": len(results),
        "results": results[:20]
    }}


def search_classes(keyword: str, limit: int = 50) -> Dict[str, Any]:
    """搜索包含关键字的类"""
    class_idx = _get_class_index()

    if class_idx:
        # 使用索引搜索（快速 < 10ms）
        results = class_idx.search_by_keyword(keyword, limit)
        return {{
            "_meta": _get_kb_meta(),
            "keyword": keyword,
            "found_count": len(results),
            "results": results
        }}
    else:
        # 回退到遍历搜索（慢速 ~5s）
        all_modules = _get_global_modules()
        results = []
        keyword_lower = keyword.lower()

        for module_name in list(all_modules.keys())[:100]:
            graph = _load_module_graph(module_name)
            if not graph:
                continue

            for node, node_data in graph.nodes(data=True):
                if node_data.get('type') != 'class':
                    continue

                class_name = node_data.get('name', '')
                if keyword_lower in class_name.lower():
                    results.append({{
                        "class": class_name,
                        "module": module_name,
                        "is_uclass": node_data.get('is_uclass', False),
                        "file": node_data.get('file', '')
                    }})

                    if len(results) >= limit:
                        break

            if len(results) >= limit:
                break

        return {{
            "_meta": _get_kb_meta(),
            "keyword": keyword,
            "found_count": len(results),
            "results": results
        }}


def search_functions(keyword: str, limit: int = 50) -> Dict[str, Any]:
    """搜索包含关键字的函数"""
    func_idx = _get_function_index()

    if func_idx:

def query_memory_promote(trace_id: str, intent: str, seed: str) -> Dict[str, Any]:
    """把当前 trace 提升为推荐查询路线。"""
    result = query_memory_record(trace_id, intent, seed)
    memory_id = result.get("memory_id")
    if memory_id:
        validation = query_memory_validate(memory_id)
        result["promotion_validation"] = validation
        result["promoted"] = validation.get("overall") == "fresh"
        if not result["promoted"]:
            result["promotion_blocked_reason"] = validation.get("overall", "unknown")
    return result



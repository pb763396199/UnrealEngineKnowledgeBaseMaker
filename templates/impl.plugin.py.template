# ============================================================================

if __name__ == "__main__":
    import sys
    import json

    def _print_usage():
        print("Usage: py impl.py <command> [args...]", file=sys.stderr)
        print("", file=sys.stderr)
        print("Commands:", file=sys.stderr)
        print("  query_class_info <class_name>              - 查询类信息", file=sys.stderr)
        print("  query_class_hierarchy <class_name> [depth] - 查询类继承关系", file=sys.stderr)
        print("  query_module_dependencies <module_name>    - 查询模块依赖", file=sys.stderr)
        print("  query_module_classes <module_name> [type]  - 查询模块中的类", file=sys.stderr)
        print("  query_function_info <function_name> [hint] - 查询函数信息", file=sys.stderr)
        print("  get_function_implementation <function_name> [class_name] [hint] - 获取函数实现", file=sys.stderr)
        print("  search_functions <keyword> [limit]         - 搜索函数", file=sys.stderr)
        print("  search_classes <keyword> [limit]           - 搜索类", file=sys.stderr)
        print("  search_modules <keyword>                   - 搜索模块", file=sys.stderr)
        print("  get_statistics                             - 获取统计信息", file=sys.stderr)
        print("  get_kb_info                                - 获取知识库版本信息", file=sys.stderr)
        print("  query_callees <function_name> [class_name] [limit]   - 查询函数调用的 callees", file=sys.stderr)
        print("  query_callers <function_name> [class_name] [limit]   - 查询调用该函数的 callers", file=sys.stderr)
        print("  query_symbol_references <symbol_name> [limit]        - 查询符号的所有引用", file=sys.stderr)
        print("", file=sys.stderr)
        print("Branch Management:", file=sys.stderr)
        print("  init [--kb_store <path>]                   - 初始化多分支注册表", file=sys.stderr)
        print("  register <branch> <source> [--kb <path>]   - 注册分支并导入 KB", file=sys.stderr)
        print("  update <branch> <source> [--force]         - 构建/更新分支 KB", file=sys.stderr)
        print("  status                                     - 查看所有分支状态", file=sys.stderr)
        print("  set_active <branch>                        - 切换活跃分支", file=sys.stderr)
        print("  check_freshness <source>                   - 检查 KB 新鲜度", file=sys.stderr)
        print("  remove <branch> [--delete-data]            - 移除分支", file=sys.stderr)
        print("  gc [--dry-run]                             - 垃圾回收", file=sys.stderr)
        print("", file=sys.stderr)
        print("Examples:", file=sys.stderr)
        print('  py impl.py query_class_info AActor', file=sys.stderr)
        print('  py impl.py query_class_hierarchy AActor 5', file=sys.stderr)
        print('  py impl.py search_classes "Player" 20', file=sys.stderr)
        print('  py impl.py init', file=sys.stderr)
        print('  py impl.py register DEV /path/to/source', file=sys.stderr)
        print('  py impl.py set_active DEV', file=sys.stderr)
        sys.exit(1)

    if len(sys.argv) < 2:
        _print_usage()

    command = sys.argv[1]

    try:
        if command == "query_class_info":
            if len(sys.argv) < 3:
                print("Error: Missing class_name argument", file=sys.stderr)
                _print_usage()
            result = query_class_info(sys.argv[2])
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_class_hierarchy":
            if len(sys.argv) < 3:
                print("Error: Missing class_name argument", file=sys.stderr)
                _print_usage()
            depth = int(sys.argv[3]) if len(sys.argv) > 3 else 3
            result = query_class_hierarchy(sys.argv[2], depth)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_module_dependencies":
            if len(sys.argv) < 3:
                print("Error: Missing module_name argument", file=sys.stderr)
                _print_usage()
            result = query_module_dependencies(sys.argv[2])
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_module_classes":
            if len(sys.argv) < 3:
                print("Error: Missing module_name argument", file=sys.stderr)
                _print_usage()
            class_type = sys.argv[3] if len(sys.argv) > 3 else None
            result = query_module_classes(sys.argv[2], class_type)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_function_info":
            if len(sys.argv) < 3:
                print("Error: Missing function_name argument", file=sys.stderr)
                _print_usage()
            module_hint = sys.argv[3] if len(sys.argv) > 3 else None
            result = query_function_info(sys.argv[2], module_hint)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "get_function_implementation":
            if len(sys.argv) < 3:
                print("Error: Missing function_name argument", file=sys.stderr)
                _print_usage()
            class_name = sys.argv[3] if len(sys.argv) > 3 else None
            module_hint = sys.argv[4] if len(sys.argv) > 4 else None
            result = get_function_implementation(sys.argv[2], class_name, module_hint)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "search_functions":
            if len(sys.argv) < 3:
                print("Error: Missing keyword argument", file=sys.stderr)
                _print_usage()
            limit = int(sys.argv[3]) if len(sys.argv) > 3 else 50
            result = search_functions(sys.argv[2], limit)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "search_classes":
            if len(sys.argv) < 3:
                print("Error: Missing keyword argument", file=sys.stderr)
                _print_usage()
            limit = int(sys.argv[3]) if len(sys.argv) > 3 else 50
            result = search_classes(sys.argv[2], limit)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "search_modules":
            if len(sys.argv) < 3:
                print("Error: Missing keyword argument", file=sys.stderr)
                _print_usage()
            result = search_modules(sys.argv[2])
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "get_statistics":
            result = get_statistics()
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "get_kb_info":
            result = get_kb_info()
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_callees":
            if len(sys.argv) < 3:
                print("Error: Missing function_name argument", file=sys.stderr)
                _print_usage()
            class_name = sys.argv[3] if len(sys.argv) > 3 else None
            limit = int(sys.argv[4]) if len(sys.argv) > 4 else 50
            result = query_callees(sys.argv[2], class_name, limit)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_callers":
            if len(sys.argv) < 3:
                print("Error: Missing function_name argument", file=sys.stderr)
                _print_usage()
            class_name = sys.argv[3] if len(sys.argv) > 3 else None
            limit = int(sys.argv[4]) if len(sys.argv) > 4 else 50
            result = query_callers(sys.argv[2], class_name, limit)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "query_symbol_references":
            if len(sys.argv) < 3:
                print("Error: Missing symbol_name argument", file=sys.stderr)
                _print_usage()
            limit = int(sys.argv[3]) if len(sys.argv) > 3 else 50
            result = query_symbol_references(sys.argv[2], limit)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        # ================================================================
        # 多分支管理命令
        # ================================================================
        elif command == "init":
            kb_store = None
            if "--kb_store" in sys.argv:
                idx = sys.argv.index("--kb_store")
                kb_store = sys.argv[idx + 1] if idx + 1 < len(sys.argv) else None
            result = _branch_mgr.init_registry(kb_store)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "register":
            if len(sys.argv) < 4:
                print("Error: register <branch> <source> [--kb <path>]", file=sys.stderr)
                _print_usage()
            branch_name = sys.argv[2]
            source = sys.argv[3]
            kb_path = None
            if "--kb" in sys.argv:
                idx = sys.argv.index("--kb")
                kb_path = sys.argv[idx + 1] if idx + 1 < len(sys.argv) else None
            desc = ""
            if "--desc" in sys.argv:
                idx = sys.argv.index("--desc")
                desc = sys.argv[idx + 1] if idx + 1 < len(sys.argv) else ""
            result = _branch_mgr.register(branch_name, source, kb_path, desc)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "update":
            if len(sys.argv) < 4:
                print("Error: update <branch> <source> [--force]", file=sys.stderr)
                _print_usage()
            branch_name = sys.argv[2]
            source = sys.argv[3]
            force = "--force" in sys.argv
            desc = ""
            if "--desc" in sys.argv:
                idx = sys.argv.index("--desc")
                desc = sys.argv[idx + 1] if idx + 1 < len(sys.argv) else ""
            result = _branch_mgr.update(branch_name, source, force, desc)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "status":
            result = _branch_mgr.status()
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "set_active":
            if len(sys.argv) < 3:
                print("Error: set_active <branch>", file=sys.stderr)
                _print_usage()
            result = _branch_mgr.set_active(sys.argv[2])
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "check_freshness":
            if len(sys.argv) < 3:
                print("Error: check_freshness <source>", file=sys.stderr)
                _print_usage()
            result = _branch_mgr.check_freshness(sys.argv[2])
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "remove":
            if len(sys.argv) < 3:
                print("Error: remove <branch> [--delete-data]", file=sys.stderr)
                _print_usage()
            delete_data = "--delete-data" in sys.argv
            result = _branch_mgr.remove(sys.argv[2], delete_data)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        elif command == "gc":
            dry_run = "--dry-run" in sys.argv
            result = _branch_mgr.gc(dry_run)
            print(json.dumps(result, ensure_ascii=False, indent=2))

        else:
            print(f"Error: Unknown command '{command}'", file=sys.stderr)
            _print_usage()

    except Exception as e:
        error_result = {"error": str(e), "command": command, "args": sys.argv[2:]}
        print(json.dumps(error_result, ensure_ascii=False, indent=2))
        sys.exit(1)

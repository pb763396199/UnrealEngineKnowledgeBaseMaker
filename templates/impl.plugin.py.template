def _find_module_for_class(class_name: str) -> Optional[str]:
    """查找类所在的模块"""
    all_modules = _get_global_modules()

    # 优先级列表
    priority_modules = ['Core', 'CoreUObject', 'Engine', 'Renderer', 'RHI']

    # 1. 先搜索优先级模块
    for module_name in priority_modules:
        graph = _load_module_graph(module_name)
        if graph and f"class_{{class_name}}" in graph.nodes:
            return module_name

    # 2. 搜索所有 Runtime 模块
    for module_name, info in all_modules.items():
        if info.get('category') == 'Runtime':
            if module_name in priority_modules:
                continue
            graph = _load_module_graph(module_name)
            if graph and f"class_{{class_name}}" in graph.nodes:
                return module_name

    # 3. 搜索所有模块（限制前200个）
    for module_name in list(all_modules.keys())[:200]:
        if module_name in priority_modules:
            continue
        graph = _load_module_graph(module_name)
        if graph and f"class_{{class_name}}" in graph.nodes:
            return module_name

    return None


def get_function_implementation(function_name: str, class_name: str = None, module_hint: str = None) -> Dict[str, Any]:
    """
    获取函数的实现代码

    首先查询函数索引找到实现文件位置，然后读取 cpp 文件内容返回。
    这是解决 LLM 需要查看函数实现的核心功能。

    Args:
        function_name: 函数名称
        class_name: 类名称（可选，用于处理同名函数）
        module_hint: 模块提示（可选，用于加速查询）

    Returns:
        包含函数实现信息的字典
    """
    func_idx = _get_function_index()
    if not func_idx:
        return {"error": "Function index not available"}

    # 查询函数信息
    results = func_idx.query_by_name(function_name, module_hint)
    if class_name:
        results = [r for r in results if r.get('class_name') == class_name]

    if not results:
        return {"error": f"Function {function_name} not found"}

    # 优先选择有 impl_file_path 的结果
    func_info = results[0]
    for r in results:
        if r.get('impl_file_path'):
            func_info = r
            break
    impl_file = func_info.get('impl_file_path')
    impl_line = func_info.get('impl_line_number', 0)

    # 回退：如果 impl_file 为空但声明文件本身是 .cpp，则声明即实现
    if not impl_file:
        decl_file = func_info.get('file_path', '')
        if decl_file.endswith('.cpp'):
            impl_file = decl_file
            impl_line = func_info.get('line_number', 0)

    impl_path = _resolve_source_file(impl_file) if impl_file else None

    if not impl_file or impl_path is None or not impl_path.exists():
        return {
            "error": f"Implementation file not found for {function_name}",
            "declaration_location": f"{func_info.get('file_path')}:{func_info.get('line_number')}"
        }

    # 读取实现文件内容
    try:
        with open(impl_path, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()

        # 按行号提取函数附近代码（前 10 行 ~ 后 200 行）
        if impl_line and impl_line > 0:
            start = max(0, impl_line - 11)
            end = min(len(lines), impl_line + 200)
            context_lines = lines[start:end]
            content = ''.join(context_lines)
            line_info = f"lines {start+1}-{end}"
        else:
            content = ''.join(lines)
            if len(content) > 10000:
                content = content[:10000] + "... (truncated)"
            line_info = f"lines 1-{len(lines)}"

        return {
            "_meta": _get_kb_meta(),
            "function": function_name,
            "class": func_info.get('class_name'),
            "module": func_info.get('module'),
            "declaration_file": func_info.get('file_path'),
            "declaration_line": func_info.get('line_number'),
            "implementation_file": impl_file,
            "implementation_line": impl_line,
            "file_content": content,
            "extracted_range": line_info
        }
    except Exception as e:
        return {"error": f"Failed to read implementation file: {e}"}

def query_callees(function_name: str, class_name: str = None, limit: int = 50) -> Dict[str, Any]:
    """查询某函数调用的所有目标（callees）"""
    sri = _get_symbol_reference_index()
    if not sri:
        return {{"found_count": 0, "results": [], "error": "symbol_reference_index.db not found"}}
    rows = sri.query_callees(function_name, class_name, limit)
    return {{
        "_meta": _get_kb_meta(),
        "function_name": function_name,
        "class_name": class_name,
        "found_count": len(rows),
        "results": rows,
    }}


def query_callers(function_name: str, class_name: str = None, limit: int = 50) -> Dict[str, Any]:
    """查询调用某函数的所有 callers"""
    sri = _get_symbol_reference_index()
    if not sri:
        return {{"found_count": 0, "results": [], "error": "symbol_reference_index.db not found"}}
    rows = sri.query_callers(function_name, class_name, limit)
    return {{
        "_meta": _get_kb_meta(),
        "function_name": function_name,
        "class_name": class_name,
        "found_count": len(rows),
        "results": rows,
    }}


def query_symbol_references(symbol_name: str, limit: int = 50) -> Dict[str, Any]:
    """查询所有引用某 symbol 的记录（call 或 type_reference）"""
    sri = _get_symbol_reference_index()
    if not sri:
        return {{"found_count": 0, "results": [], "error": "symbol_reference_index.db not found"}}
    rows = sri.query_symbol_references(symbol_name, limit)
    return {{
        "_meta": _get_kb_meta(),
        "symbol_name": symbol_name,
        "found_count": len(rows),
        "results": rows,
    }}


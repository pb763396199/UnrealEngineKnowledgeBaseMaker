SKILL_DIR = Path(__file__).parent

# 知识库路径 — 无 registry 时兼容硬编码路径；registry 异常时 fail-closed
_DEFAULT_KB_PATH = Path(r"{KB_PATH}")
_branch_mgr = BranchManager(SKILL_DIR)
_KB_RESOLUTION_ERROR = None
_UNRESOLVED_KB_PATH = SKILL_DIR / "runtime" / "unresolved_kb"


def _resolve_kb_path(variant: str = None) -> Path:
    """解析活跃 KB 路径；registry 存在但异常时不回退旧 KB"""
    global _KB_RESOLUTION_ERROR
    try:
        _KB_RESOLUTION_ERROR = None
        return _branch_mgr.resolve_kb_path(variant)
    except FileNotFoundError as e:
        if not _branch_mgr.registry_db.exists():
            _KB_RESOLUTION_ERROR = None
            return _DEFAULT_KB_PATH
        _KB_RESOLUTION_ERROR = f"resolve_kb_path failed: {type(e).__name__}: {e}"
        print(f"[KB] ERROR: {_KB_RESOLUTION_ERROR}", file=sys.stderr)
        return _UNRESOLVED_KB_PATH
    except Exception as e:
        _KB_RESOLUTION_ERROR = f"resolve_kb_path failed: {type(e).__name__}: {e}"
        print(f"[KB] ERROR: {_KB_RESOLUTION_ERROR}", file=sys.stderr)
        return _UNRESOLVED_KB_PATH


def _registry_resolution_error() -> Optional[str]:
    return _KB_RESOLUTION_ERROR


KB_PATH = _resolve_kb_path()


def _resolve_source_root(variant: str = None) -> Optional[Path]:
    """解析源码根目录（来自 registry versions.source_path），失败时返回 None"""
    try:
        return _branch_mgr.resolve_source_path(variant)
    except Exception as e:
        print(f"[KB] WARNING: resolve_source_path failed ({type(e).__name__}: {e})", file=sys.stderr)
        return None


SOURCE_ROOT = _resolve_source_root()


def _resolve_source_file(path_value: str) -> Path:
    """将 impl_file_path（可能是相对路径）解析为绝对路径"""
    p = Path(path_value)
    if p.is_absolute():
        return p
    if SOURCE_ROOT is not None:
        parts = path_value.replace("\\", "/").split("/")
        return SOURCE_ROOT.joinpath(*parts)
    return p


def _get_runtime_context() -> Dict[str, Any]:
    """收集当前 KB 的运行时上下文和索引状态"""
    current_source = _find_plugin_root_from_cwd() or SOURCE_ROOT
    context = _build_preflight(
        skill_dir=SKILL_DIR,
        kb_path=KB_PATH,
        source_root=current_source,
        branch_manager=_branch_mgr,
    )
    if _registry_resolution_error():
        context["data_trust"] = "stale"
        context["fresh"] = False
        context["stale_reason"] = "kb_resolution_failed"
        context["registry_error"] = _registry_resolution_error()
    return context


def preflight() -> Dict[str, Any]:
    """查询前检查 KB/source/indices 新鲜度"""
    return _get_runtime_context()


def query_audit(trace_id: str = None, limit: int = 20) -> Dict[str, Any]:
    """查看最近查询审计记录（SKILL_DIR/runtime/query_audit.db）"""
    audit = QueryAudit.for_skill(SKILL_DIR)
    try:
        return audit.recent(trace_id, limit)
    finally:
        audit.close()


def query_audit_report(trace_id: str = None, limit: int = 200, broad_threshold: int = 40) -> Dict[str, Any]:
    """从 query_audit.db 生成确定性静态统计报告，不读取源码正文。"""
    audit = QueryAudit.for_skill(SKILL_DIR)
    try:
        return audit.report(trace_id, limit, broad_threshold)
    finally:
        audit.close()



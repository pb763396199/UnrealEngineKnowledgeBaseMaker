def _find_module_for_class(class_name: str) -> Optional[str]:
    """查找类所在的模块"""
    all_modules = _get_global_modules()

    # 优先级列表
    priority_modules = ['Core', 'CoreUObject', 'Engine', 'Renderer', 'RHI']

    # 1. 先搜索优先级模块
    for module_name in priority_modules:
        graph = _load_module_graph(module_name)
        if graph and f"class_{{class_name}}" in graph.nodes:
            return module_name

    # 2. 搜索所有 Runtime 模块
    for module_name, info in all_modules.items():
        if info.get('category') == 'Runtime':
            if module_name in priority_modules:
                continue
            graph = _load_module_graph(module_name)
            if graph and f"class_{{class_name}}" in graph.nodes:
                return module_name

    # 3. 搜索所有模块（限制前200个）
    for module_name in list(all_modules.keys())[:200]:
        if module_name in priority_modules:
            continue
        graph = _load_module_graph(module_name)
        if graph and f"class_{{class_name}}" in graph.nodes:
            return module_name

    return None


def _extract_function_block(lines: List[str], impl_line: int) -> Optional[tuple]:
    """从实现行开始按花括号边界提取完整函数块。"""
    if not impl_line or impl_line <= 0:
        return None

    total = len(lines)
    start_idx = max(0, impl_line - 1)
    search_end = min(start_idx + 30, total)
    search_text = ''.join(lines[start_idx:search_end])
    brace_offset = _find_first_open_brace_offset(search_text)
    if brace_offset < 0:
        return None

    scan_end = min(start_idx + 5000, total)
    combined = ''.join(lines[start_idx:scan_end])
    close_offset = _find_matching_close_brace_offset(combined[brace_offset:])
    if close_offset < 0:
        return None

    end_line_idx = start_idx + combined[:brace_offset + close_offset].count('\n')
    return start_idx + 1, end_line_idx + 1, lines[start_idx:end_line_idx + 1]


def _find_first_open_brace_offset(text: str) -> int:
    """查找不在字符串或注释中的首个左花括号。"""
    in_string = False
    in_char = False
    in_line_comment = False
    in_block_comment = False
    i = 0
    while i < len(text):
        c = text[i]
        if in_line_comment:
            if c == '\n':
                in_line_comment = False
        elif in_block_comment:
            if c == '*' and i + 1 < len(text) and text[i + 1] == '/':
                in_block_comment = False
                i += 1
        elif in_string:
            if c == '\\':
                i += 1
            elif c == '"':
                in_string = False
        elif in_char:
            if c == '\\':
                i += 1
            elif c == "'":
                in_char = False
        else:
            if c == '/' and i + 1 < len(text):
                if text[i + 1] == '/':
                    in_line_comment = True
                    i += 1
                elif text[i + 1] == '*':
                    in_block_comment = True
                    i += 1
            elif c == '"':
                in_string = True
            elif c == "'":
                in_char = True
            elif c == '{':
                return i
        i += 1
    return -1


def _find_matching_close_brace_offset(text: str) -> int:
    """从首个左花括号开始查找匹配的右花括号。"""
    in_string = False
    in_char = False
    in_line_comment = False
    in_block_comment = False
    brace_count = 0
    i = 0
    while i < len(text):
        c = text[i]
        if in_line_comment:
            if c == '\n':
                in_line_comment = False
        elif in_block_comment:
            if c == '*' and i + 1 < len(text) and text[i + 1] == '/':
                in_block_comment = False
                i += 1
        elif in_string:
            if c == '\\':
                i += 1
            elif c == '"':
                in_string = False
        elif in_char:
            if c == '\\':
                i += 1
            elif c == "'":
                in_char = False
        else:
            if c == '/' and i + 1 < len(text):
                if text[i + 1] == '/':
                    in_line_comment = True
                    i += 1
                elif text[i + 1] == '*':
                    in_block_comment = True
                    i += 1
            elif c == '"':
                in_string = True
            elif c == "'":
                in_char = True
            elif c == '{':
                brace_count += 1
            elif c == '}':
                brace_count -= 1
                if brace_count == 0:
                    return i
        i += 1
    return -1


def _function_impl_location(func_info: Dict[str, Any]) -> tuple:
    impl_file = func_info.get('impl_file_path') or ''
    impl_line = func_info.get('impl_line_number', 0) or 0
    if not impl_file:
        decl_file = func_info.get('file_path', '') or ''
        if decl_file.endswith('.cpp'):
            impl_file = decl_file
            impl_line = func_info.get('line_number', 0) or 0
    return impl_file, impl_line


def _summarize_function_candidate(func_info: Dict[str, Any]) -> Dict[str, Any]:
    impl_file, impl_line = _function_impl_location(func_info)
    return {
        "class": func_info.get('class_name'),
        "module": func_info.get('module'),
        "signature": func_info.get('signature'),
        "declaration_file": func_info.get('file_path'),
        "declaration_line": func_info.get('line_number'),
        "implementation_file": impl_file,
        "implementation_line": impl_line,
    }


def _select_function_implementation_candidate(
    results: List[Dict[str, Any]],
    *,
    class_name: str = None,
    signature_hint: str = None,
) -> Dict[str, Any]:
    if class_name:
        results = [r for r in results if r.get('class_name') == class_name]
    if signature_hint:
        results = [r for r in results if signature_hint in (r.get('signature') or '')]

    candidates = []
    seen = set()
    for result in results:
        impl_file, impl_line = _function_impl_location(result)
        if not impl_file:
            continue
        key = (
            impl_file,
            impl_line,
            result.get('class_name') or '',
            result.get('module') or '',
        )
        if key in seen:
            continue
        seen.add(key)
        candidates.append(result)

    if not candidates:
        return {"error": "implementation_not_found"}
    if len(candidates) > 1:
        return {
            "error": "ambiguous_function_implementation",
            "ambiguous": True,
            "candidate_count": len(candidates),
            "candidates": [_summarize_function_candidate(item) for item in candidates[:20]],
            "hint": "Pass class_name/module_hint/signature_hint to disambiguate",
        }
    return {"candidate": candidates[0]}


def get_function_implementation(
    function_name: str,
    class_name: str = None,
    module_hint: str = None,
    signature_hint: str = None,
) -> Dict[str, Any]:
    """
    获取函数的实现代码

    首先查询函数索引找到实现文件位置，然后读取 cpp 文件内容返回。
    这是 Agent 需要静态查看函数实现时的核心功能。

    Args:
        function_name: 函数名称
        class_name: 类名称（可选，用于处理同名函数）
        module_hint: 模块提示（可选，用于加速查询）

    Returns:
        包含函数实现信息的字典
    """
    func_idx = _get_function_index()
    if not func_idx:
        return {"error": "Function index not available"}

    # 查询函数信息
    results = func_idx.query_by_name(function_name, module_hint)
    if not results:
        return {"error": f"Function {function_name} not found"}

    selection = _select_function_implementation_candidate(
        results,
        class_name=class_name,
        signature_hint=signature_hint,
    )
    if selection.get("ambiguous"):
        selection["function"] = function_name
        selection["_meta"] = _get_kb_meta()
        return selection
    if "candidate" not in selection:
        return {
            "error": f"Implementation file not found for {function_name}",
            "candidates": [_summarize_function_candidate(item) for item in results[:20]],
        }

    func_info = selection["candidate"]
    impl_file, impl_line = _function_impl_location(func_info)

    impl_path = _resolve_source_file(impl_file) if impl_file else None

    if not impl_file or impl_path is None or not impl_path.exists():
        return {
            "error": f"Implementation file not found for {function_name}",
            "declaration_location": f"{func_info.get('file_path')}:{func_info.get('line_number')}"
        }

    slice_result = source_slice(_path_under_root(impl_file, SOURCE_ROOT), impl_line or 1, "function")
    if "error" in slice_result:
        return slice_result

    return {
        "_meta": _get_kb_meta(),
        "function": function_name,
        "class": func_info.get('class_name'),
        "module": func_info.get('module'),
        "declaration_file": func_info.get('file_path'),
        "declaration_line": func_info.get('line_number'),
        "implementation_file": impl_file,
        "implementation_line": impl_line,
        "file_content": slice_result.get("content", ""),
        "extracted_range": f"lines {slice_result.get('line_start')}-{slice_result.get('line_end')}",
        "boundary_found": slice_result.get("boundary_hit", False),
    }

def query_callees(
    function_name: str,
    class_name: str = None,
    limit: int = 50,
    confidence: str = "resolved",
) -> Dict[str, Any]:
    """查询某函数调用的所有目标（callees）"""
    sri = _get_symbol_reference_index()
    if not sri:
        return {{"found_count": 0, "results": [], "error": "symbol_reference_index.db not found"}}
    rows = sri.query_callees(function_name, class_name, limit, confidence)
    return {{
        "_meta": _get_kb_meta(),
        "function_name": function_name,
        "class_name": class_name,
        "confidence": confidence,
        "resolution_state": confidence,
        "found_count": len(rows),
        "results": rows,
    }}


def query_callers(
    function_name: str,
